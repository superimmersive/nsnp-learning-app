default_platform(:ios)

# Existing project: app/ios/App/App.xcodeproj. Do not generate a new one.
# Build 1.0.0 (1) is already on internal TestFlight. This lane uploads a higher build.

XCODE_PROJECT = "App/App.xcodeproj"
SCHEME = "App"
TEAM = "U5DGDWXQCP"
BUNDLE_ID = "za.co.superimmersive.nsnp"
platform :ios do
  desc "Archive the existing App scheme. Does not upload."
  lane :archive do
    build_release
  end

  desc "Archive and upload to internal TestFlight. Does not submit for review."
  lane :beta do
    build_release
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end

def build_release
  sh("cd .. && npm run cap:sync")
  build_number = ENV.fetch("IOS_BUILD_NUMBER", "2")
  version_name = ENV.fetch("IOS_VERSION", "1.0.0")
  unless build_number.match?(/\A[0-9]+\z/) && build_number.to_i >= 2
    UI.user_error!("IOS_BUILD_NUMBER must be an integer of 2 or more. Build 1 is already on TestFlight.")
  end

  build_app(
    project: XCODE_PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    destination: "generic/platform=iOS",
    export_method: "app-store",
    export_team_id: TEAM,
    xcargs: [
      "DEVELOPMENT_TEAM=#{TEAM}",
      "CODE_SIGN_STYLE=Automatic",
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "MARKETING_VERSION=#{version_name}",
      "-allowProvisioningUpdates",
    ].join(" "),
  )
end

def asc_api_key
  key_id = ENV["ASC_KEY_ID"]
  issuer_id = ENV["ASC_ISSUER_ID"]
  UI.user_error!("Set ASC_KEY_ID and ASC_ISSUER_ID. The key id on the account is S78XAXRG43.") if key_id.to_s.empty? || issuer_id.to_s.empty?

  if !ENV["ASC_KEY_CONTENT"].to_s.empty?
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: ENV["ASC_KEY_CONTENT_BASE64"] == "true",
    )
  elsif !ENV["ASC_KEY_PATH"].to_s.empty?
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: ENV["ASC_KEY_PATH"],
    )
  else
    UI.user_error!("Set ASC_KEY_PATH or ASC_KEY_CONTENT. Do not commit the .p8 file.")
  end
end
