# Local values only. Do not put real passwords, API keys, or personal numbers here.
# Production secrets belong in Azure Key Vault, not in git.

DATABASE_URL=postgres://nsnp_migrator:nsnp_migrator@127.0.0.1:5432/nsnp
DATABASE_APP_URL=postgres://nsnp_app:nsnp_app@127.0.0.1:5432/nsnp
PORT=8787

# console prints the SMS code. local-sa and twilio are stubs until Devon supplies an account.
SMS_PROVIDER=console
SMS_PEPPER=local-dev-sms-pepper
TOKEN_PEPPER=local-dev-token-pepper
PIN_PEPPER=local-dev-pin-pepper
OTP_MINUTES=10
JOIN_CODE_DAYS=14
SESSION_DAYS=30
TRIAL_DISTRICT_NAME=Eden and Central Karoo Education District

# Fixture sessions created by the seed. Change them before any shared environment.
SEED_OFFICIAL_TOKEN=local-dev-official
SEED_ADMIN_TOKEN=local-dev-admin

# Only used if SMS_PROVIDER=local-sa. Leave blank until there is an account.
LOCAL_SA_SMS_URL=
LOCAL_SA_SMS_TOKEN=

# Only used if SMS_PROVIDER=twilio. Leave blank until there is an account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
